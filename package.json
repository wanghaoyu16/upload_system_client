{
  "name": "upload-system-client",
  "version": "1.4.0",
  "description": "作业上传系统客户端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "anghaoyu16",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.yourcompany.uploadsystem",
    "productName": "作业上传系统",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!dist"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  },
  "dependencies": {
    "agora-rtc-sdk-ng": "^4.24.7",
    "auto-launch": "^5.0.6",
    "easemob-websdk": "^4.15.1",
    "iconv-lite": "^0.7.2",
    "three": "^0.160.0"
  }
}